# SAM.gov API key (required for contract awards + entity APIs)
SAM_API_KEY=your_sam_api_key_here

# DigiKey OAuth2 credentials (optional - enables live pricing)
DIGIKEY_CLIENT_ID=your_digikey_client_id
DIGIKEY_CLIENT_SECRET=your_digikey_client_secret

# Mouser API key (optional - enables live pricing)
MOUSER_API_KEY=your_mouser_api_key

# Operational settings
CACHE_DIR=data
OUTPUT_DIR=data/output
MARKUP_THRESHOLD=10.0
CACHE_TTL_HOURS=168
LOG_LEVEL=INFO
