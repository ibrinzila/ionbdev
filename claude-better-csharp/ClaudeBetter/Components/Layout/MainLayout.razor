@inherits LayoutComponentBase

<div class="app-container">
    <header class="app-header">
        <div class="header-brand">
            <span class="brand-icon">&#9670;</span>
            <span class="brand-text">claude-better-csharp</span>
            <span class="brand-badge">.NET 8</span>
        </div>
        <nav class="header-nav">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-item">Chat</NavLink>
            <NavLink href="/bench" class="nav-item">Benchmarks</NavLink>
        </nav>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">X</a>
</div>
