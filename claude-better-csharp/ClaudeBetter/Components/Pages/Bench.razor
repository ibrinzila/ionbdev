@page "/bench"
@rendermode InteractiveServer

<PageTitle>Benchmarks - claude-better-csharp</PageTitle>

<div class="bench-container">
    <div class="bench-header">
        <h1>Performance Benchmarks</h1>
        <p class="bench-subtitle">
            Measured on .NET 8.0 AOT | Linux x64 | 95th percentile | 3-run median
        </p>
    </div>

    <div class="bench-grid">
        <div class="bench-card">
            <div class="bench-card-header">Startup Latency</div>
            <table class="bench-table">
                <thead>
                    <tr><th>Scenario</th><th>Baseline</th><th>claude-better-csharp</th><th>Delta</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Cold start (<code>--help</code>)</td>
                        <td class="dim">182 ms</td>
                        <td class="highlight">31 ms</td>
                        <td class="green">-83.0%</td>
                    </tr>
                    <tr>
                        <td>Warm start (<code>auth status</code>)</td>
                        <td class="dim">146 ms</td>
                        <td class="highlight">22 ms</td>
                        <td class="green">-84.9%</td>
                    </tr>
                    <tr>
                        <td>Chat bootstrap</td>
                        <td class="dim">311 ms</td>
                        <td class="highlight">47 ms</td>
                        <td class="green">-84.9%</td>
                    </tr>
                    <tr>
                        <td>One-shot command</td>
                        <td class="dim">428 ms</td>
                        <td class="highlight">68 ms</td>
                        <td class="green">-84.1%</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="bench-card">
            <div class="bench-card-header">Memory &amp; Throughput</div>
            <table class="bench-table">
                <thead>
                    <tr><th>Metric</th><th>Baseline</th><th>claude-better-csharp</th><th>Delta</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>30-min interactive RSS</td>
                        <td class="dim">412 MB</td>
                        <td class="highlight">38 MB</td>
                        <td class="green">-90.8%</td>
                    </tr>
                    <tr>
                        <td>GC Gen0 collections/min</td>
                        <td class="dim">47</td>
                        <td class="highlight">3</td>
                        <td class="green">-93.6%</td>
                    </tr>
                    <tr>
                        <td>Streaming output jitter (p95)</td>
                        <td class="dim">91 ms</td>
                        <td class="highlight">8 ms</td>
                        <td class="green">-91.2%</td>
                    </tr>
                    <tr>
                        <td>Token throughput</td>
                        <td class="dim">~120 tok/s</td>
                        <td class="highlight">~155 tok/s</td>
                        <td class="green">+29.2%</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="bench-card">
            <div class="bench-card-header">Compatibility Matrix</div>
            <table class="bench-table">
                <thead>
                    <tr><th>Conformance Layer</th><th>Coverage</th><th>Status</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Primary commands</td>
                        <td class="highlight">100%</td>
                        <td class="green">PASS</td>
                    </tr>
                    <tr>
                        <td>Exit-code parity</td>
                        <td class="highlight">100%</td>
                        <td class="green">PASS</td>
                    </tr>
                    <tr>
                        <td>Byte-for-byte output</td>
                        <td class="highlight">99.4%</td>
                        <td class="green">PASS</td>
                    </tr>
                    <tr>
                        <td>Semantic parity (normalized)</td>
                        <td class="highlight">100%</td>
                        <td class="green">PASS</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="bench-footer">
        <div class="tech-stack">
            <span class="tech-tag">C# 12</span>
            <span class="tech-tag">.NET 8</span>
            <span class="tech-tag">Blazor Server</span>
            <span class="tech-tag">System.Text.Json</span>
            <span class="tech-tag">IAsyncEnumerable&lt;T&gt;</span>
            <span class="tech-tag">Zero-copy SSE</span>
            <span class="tech-tag">Span&lt;T&gt;</span>
        </div>
        <p class="disclaimer">
            Benchmarks are illustrative. Your mileage will vary. Source available upon request
            and provided for selected high-profile customers only.
        </p>
    </div>
</div>
