@model List<ChangeReview>
@{
    ViewData["Title"] = $"Code Reviews - {ViewBag.TeamName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Code Reviews - @ViewBag.TeamName</h4>
    <a asp-controller="Teams" asp-action="Detail" asp-route-id="@ViewBag.TeamId" class="btn btn-sm btn-outline-primary">
        Back to Team
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-code-square display-1 text-muted"></i>
        <h5 class="mt-3 text-muted">No reviews yet</h5>
        <p class="text-muted">Reviews will appear here when agents submit code changes for review.</p>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Review</th><th>Task</th><th>Files</th><th>State</th><th>Created</th><th></th></tr></thead>
                <tbody>
                    @foreach (var review in Model)
                    {
                        var stateClass = review.State switch
                        {
                            ReviewDecisionState.Approved => "success",
                            ReviewDecisionState.Rejected => "danger",
                            ReviewDecisionState.PartiallyApproved => "warning",
                            _ => "secondary"
                        };
                        <tr>
                            <td><code class="small">@review.Id[..8]</code></td>
                            <td class="small">@review.TaskId[..Math.Min(8, review.TaskId.Length)]</td>
                            <td>@review.Files.Count files</td>
                            <td><span class="badge bg-@stateClass">@review.State</span></td>
                            <td class="text-muted small">@review.CreatedAt.ToString("g")</td>
                            <td><a asp-action="Detail" asp-route-id="@review.Id" class="btn btn-sm btn-outline-primary">Review</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
