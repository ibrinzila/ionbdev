@model TeamTask
@{
    ViewData["Title"] = Model.Title;
}

<a asp-controller="Tasks" asp-action="Kanban" asp-route-teamId="@Model.TeamId" class="btn btn-sm btn-outline-secondary mb-3">
    <i class="bi bi-arrow-left me-1"></i> Back to Board
</a>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@Model.Title</h5>
        <div class="d-flex gap-2">
            @{
                var statusClass = Model.Status switch
                {
                    TaskState.Pending => "secondary",
                    TaskState.InProgress => "primary",
                    TaskState.InReview => "warning",
                    TaskState.Completed => "success",
                    _ => "dark"
                };
            }
            <span class="badge bg-@statusClass fs-6">@Model.Status</span>
            @if (Model.ReviewStatus != ReviewState.None)
            {
                var reviewClass = Model.ReviewStatus switch
                {
                    ReviewState.Review => "warning",
                    ReviewState.NeedsFix => "danger",
                    ReviewState.Approved => "success",
                    _ => "secondary"
                };
                <span class="badge bg-@reviewClass fs-6">@Model.ReviewStatus</span>
            }
        </div>
    </div>
    <div class="card-body">
        @if (Model.Description != null)
        {
            <p>@Model.Description</p>
        }
        <div class="row">
            <div class="col-md-3"><span class="text-muted small">Assignee</span><div>@(Model.AssigneeName ?? "Unassigned")</div></div>
            <div class="col-md-3"><span class="text-muted small">Created By</span><div>@(Model.CreatedBy ?? "System")</div></div>
            <div class="col-md-3"><span class="text-muted small">Created</span><div class="small">@Model.CreatedAt.ToString("g")</div></div>
            <div class="col-md-3"><span class="text-muted small">Updated</span><div class="small">@Model.UpdatedAt.ToString("g")</div></div>
        </div>
    </div>
</div>

<!-- Status Actions -->
<div class="card mb-3">
    <div class="card-header"><h6 class="mb-0">Change Status</h6></div>
    <div class="card-body d-flex gap-2 flex-wrap">
        @foreach (TaskState state in Enum.GetValues<TaskState>())
        {
            if (state == TaskState.Deleted || state == Model.Status) continue;
            <form asp-action="UpdateStatus" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="@state" />
                <button class="btn btn-sm btn-outline-secondary">Move to @state</button>
            </form>
        }
    </div>
</div>

<!-- History -->
<div class="card">
    <div class="card-header"><h6 class="mb-0"><i class="bi bi-clock-history me-2"></i>History</h6></div>
    <div class="list-group list-group-flush">
        @foreach (var evt in Model.History.OrderByDescending(h => h.Timestamp))
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between">
                    <div class="small">
                        <span class="badge bg-dark border me-1">@evt.EventType</span>
                        @evt.Details
                        @if (evt.Actor != null) { <span class="text-muted">by @evt.Actor</span> }
                    </div>
                    <span class="text-muted" style="font-size:0.7rem;">@evt.Timestamp.ToString("g")</span>
                </div>
            </div>
        }
    </div>
</div>
