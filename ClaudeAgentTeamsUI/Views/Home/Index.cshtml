@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card bg-primary bg-opacity-10 border-primary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Active Agents</div>
                        <h3 class="mb-0">@Model.ActiveAgents</h3>
                    </div>
                    <i class="bi bi-robot fs-1 text-primary"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning bg-opacity-10 border-warning">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Pending Tasks</div>
                        <h3 class="mb-0">@Model.PendingTasks</h3>
                    </div>
                    <i class="bi bi-list-task fs-1 text-warning"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success bg-opacity-10 border-success">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Completed Tasks</div>
                        <h3 class="mb-0">@Model.CompletedTasks</h3>
                    </div>
                    <i class="bi bi-check-circle fs-1 text-success"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info bg-opacity-10 border-info">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Total Sessions</div>
                        <h3 class="mb-0">@Model.TotalSessions</h3>
                    </div>
                    <i class="bi bi-terminal fs-1 text-info"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Teams -->
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-people me-2"></i>Teams</h6>
                <a asp-controller="Teams" asp-action="Create" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg"></i> New Team
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.Teams.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-people fs-1"></i>
                        <p class="mt-2">No teams yet. Create your first team to get started.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr><th>Team</th><th>Status</th><th>Members</th><th>Active</th><th>Last Activity</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var team in Model.Teams)
                                {
                                    var statusClass = team.Status switch
                                    {
                                        TeamStatus.Running => "success",
                                        TeamStatus.Launching => "warning",
                                        TeamStatus.Failed => "danger",
                                        TeamStatus.Stopping => "warning",
                                        _ => "secondary"
                                    };
                                    <tr>
                                        <td><a asp-controller="Teams" asp-action="Detail" asp-route-id="@team.Id" class="text-decoration-none fw-medium">@team.Name</a></td>
                                        <td><span class="badge bg-@statusClass">@team.Status</span></td>
                                        <td>@team.MemberCount</td>
                                        <td>@team.ActiveMembers</td>
                                        <td><span class="text-muted small">@team.LastActivity?.ToString("g")</span></td>
                                        <td><a asp-controller="Teams" asp-action="Detail" asp-route-id="@team.Id" class="btn btn-sm btn-outline-primary">View</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header"><h6 class="mb-0"><i class="bi bi-folder me-2"></i>Recent Projects</h6></div>
            <div class="list-group list-group-flush">
                @foreach (var project in Model.RecentProjects)
                {
                    <a asp-controller="Sessions" asp-action="Index" asp-route-projectId="@project.Id"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@project.Name</strong>
                            @if (project.GitBranch != null)
                            {
                                <span class="text-muted ms-2 small"><i class="bi bi-git"></i> @project.GitBranch</span>
                            }
                        </div>
                        <span class="badge bg-secondary rounded-pill">@project.SessionCount sessions</span>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Notifications & Health -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-bell me-2"></i>Notifications</h6>
                @if (Model.UnreadNotifications > 0)
                {
                    <span class="badge bg-danger">@Model.UnreadNotifications unread</span>
                }
            </div>
            <div class="list-group list-group-flush">
                @if (!Model.RecentNotifications.Any())
                {
                    <div class="text-center text-muted py-3 small">No notifications</div>
                }
                @foreach (var notif in Model.RecentNotifications)
                {
                    var icon = notif.Category switch
                    {
                        NotificationCategory.Error => "bi-exclamation-triangle text-danger",
                        NotificationCategory.Warning => "bi-exclamation-circle text-warning",
                        NotificationCategory.TeamEvent => "bi-people text-primary",
                        NotificationCategory.TaskCompleted => "bi-check-circle text-success",
                        _ => "bi-info-circle text-info"
                    };
                    <div class="list-group-item @(!notif.IsRead ? "bg-primary bg-opacity-10" : "")">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi @icon mt-1"></i>
                            <div class="flex-grow-1">
                                <div class="small fw-medium">@notif.Title</div>
                                @if (notif.Message != null) { <div class="text-muted small">@notif.Message</div> }
                                <div class="text-muted" style="font-size:0.7rem;">@notif.CreatedAt.ToString("g")</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="card mt-3">
            <div class="card-header"><h6 class="mb-0"><i class="bi bi-heart-pulse me-2"></i>System Health</h6></div>
            <div class="card-body">
                <div class="mb-2 d-flex justify-content-between"><span class="text-muted small">Memory</span><span class="small">@Model.Health.MemoryUsageMb MB</span></div>
                <div class="mb-2 d-flex justify-content-between"><span class="text-muted small">Uptime</span><span class="small">@Model.Health.Uptime.ToString(@"hh\:mm\:ss")</span></div>
                <div class="d-flex justify-content-between"><span class="text-muted small">.NET Version</span><span class="small">@Model.Health.DotNetVersion</span></div>
            </div>
        </div>
    </div>
</div>
