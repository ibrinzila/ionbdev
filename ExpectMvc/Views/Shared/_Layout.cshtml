<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Expect</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar">
        <a class="brand" href="/">Expect</a>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/Test/Run">Run Tests</a>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        <p>Expect &mdash; Let agents test your code in a real browser.</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
