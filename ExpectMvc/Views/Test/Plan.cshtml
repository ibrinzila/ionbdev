@model PlanReviewViewModel
@{
    ViewData["Title"] = "Review Test Plan";
}

<h1>Review Test Plan</h1>
<p>Generated by <strong>@Model.Plan.Agent</strong> at @Model.Plan.CreatedAt.ToString("u")</p>
<p>@Model.Plan.Description</p>

<h2>Changed Files</h2>
<table class="table">
    <thead>
        <tr><th>File</th><th>Type</th><th>+/-</th></tr>
    </thead>
    <tbody>
        @foreach (var file in Model.Plan.SourceDiff.Files)
        {
            <tr>
                <td><code>@file.Path</code></td>
                <td>@file.Type</td>
                <td class="changes">+@file.Additions / -@file.Deletions</td>
            </tr>
        }
    </tbody>
</table>

<h2>Test Steps</h2>
<table class="table">
    <thead>
        <tr><th>#</th><th>Action</th><th>Selector</th><th>Value</th><th>Expected</th></tr>
    </thead>
    <tbody>
        @foreach (var step in Model.Plan.Steps.OrderBy(s => s.Order))
        {
            <tr>
                <td>@step.Order</td>
                <td>@step.Action</td>
                <td><code>@(step.Selector ?? "—")</code></td>
                <td>@(step.Value ?? "—")</td>
                <td>@step.Expected</td>
            </tr>
        }
    </tbody>
</table>

<form asp-action="Execute" method="post">
    <input type="hidden" name="planId" value="@Model.Plan.Id" />
    <input type="hidden" name="url" value="@Model.Url" />
    <button type="submit" class="btn btn-primary">Execute in Browser</button>
    <a href="/Test/Run" class="btn btn-secondary">Cancel</a>
</form>
