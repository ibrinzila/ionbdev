@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h1><i class="bi bi-speedometer2"></i> Dashboard</h1>
        <p class="text-muted">Overview of your AI development sessions</p>
    </div>
</div>

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Total Sessions</h6>
                        <h2>@Model.TotalSessions</h2>
                    </div>
                    <div class="fs-1 opacity-50">
                        <i class="bi bi-chat-left-text"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Total Exchanges</h6>
                        <h2>@Model.TotalExchanges</h2>
                    </div>
                    <div class="fs-1 opacity-50">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Tool Uses</h6>
                        <h2>@Model.TotalToolUses</h2>
                    </div>
                    <div class="fs-1 opacity-50">
                        <i class="bi bi-tools"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Total Tokens</h6>
                        <h2>@Model.TotalTokens.ToString("N0")</h2>
                    </div>
                    <div class="fs-1 opacity-50">
                        <i class="bi bi-hash"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Recent Sessions -->
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Recent Sessions</h5>
                <a asp-controller="Sessions" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentSessions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Session</th>
                                    <th>Provider</th>
                                    <th>Created</th>
                                    <th>Workspace</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var session in Model.RecentSessions)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Sessions" asp-action="Details"
                                               asp-route-id="@session.SessionId"
                                               asp-route-provider="@session.ProviderId">
                                                @(session.Name ?? session.SessionId[..Math.Min(12, session.SessionId.Length)])
                                            </a>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@session.ProviderName</span>
                                        </td>
                                        <td>
                                            <small class="text-muted">@session.CreatedAt</small>
                                        </td>
                                        <td>
                                            <small class="text-muted font-monospace">
                                                @(session.WorkspaceRoot != null && session.WorkspaceRoot.Length > 40
                                                    ? "..." + session.WorkspaceRoot[^40..]
                                                    : session.WorkspaceRoot)
                                            </small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">No sessions found. Start using an AI coding agent to see sessions here.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Provider Status + Sessions by Provider -->
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-plug"></i> Providers</h5>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var provider in Model.Providers)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@provider.ProviderName</strong>
                            @if (!string.IsNullOrEmpty(provider.Version))
                            {
                                <br /><small class="text-muted">v@provider.Version</small>
                            }
                        </div>
                        @if (provider.IsInstalled)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Installed</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="bi bi-x-circle"></i> Not Found</span>
                        }
                    </li>
                }
            </ul>
        </div>

        @if (Model.SessionsByProvider.Any())
        {
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-pie-chart"></i> Sessions by Provider</h5>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var kvp in Model.SessionsByProvider.OrderByDescending(x => x.Value))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @kvp.Key
                            <span class="badge bg-primary rounded-pill">@kvp.Value</span>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
