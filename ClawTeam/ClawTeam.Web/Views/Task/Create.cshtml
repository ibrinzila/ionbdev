@model CreateTaskForm
@{
    var teamName = (string)ViewBag.TeamName;
    ViewData["Title"] = $"New Task - {teamName}";
}

<div class="page-header">
    <h1>New Task &mdash; @teamName</h1>
</div>

<div class="card" style="max-width:600px;">
    <form asp-controller="Task" asp-action="Create" asp-route-id="@teamName" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="Subject">Subject</label>
            <input asp-for="Subject" class="form-control" placeholder="Implement OAuth2 flow" required />
        </div>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" class="form-control" placeholder="Detailed task description..."></textarea>
        </div>

        <div class="form-group">
            <label asp-for="Owner">Owner (agent name)</label>
            <input asp-for="Owner" class="form-control" placeholder="alice" />
        </div>

        <div class="form-group">
            <label asp-for="Priority">Priority</label>
            <select asp-for="Priority" class="form-control">
                <option value="low">Low</option>
                <option value="medium" selected>Medium</option>
                <option value="high">High</option>
                <option value="urgent">Urgent</option>
            </select>
        </div>

        <div class="form-group">
            <label asp-for="BlockedBy">Blocked By (comma-separated task IDs)</label>
            <input asp-for="BlockedBy" class="form-control" placeholder="abc12345, def67890" />
        </div>

        <div style="display:flex;gap:0.75rem;">
            <button type="submit" class="btn btn-primary">Create Task</button>
            <a href="/Task/Index/@teamName" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
