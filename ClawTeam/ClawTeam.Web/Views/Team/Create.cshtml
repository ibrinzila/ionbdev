@model CreateTeamForm
@{
    ViewData["Title"] = "Create Team";
}

<div class="page-header">
    <h1>Create Team</h1>
</div>

<div class="card" style="max-width:600px;">
    <form asp-controller="Team" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="Name">Team Name</label>
            <input asp-for="Name" class="form-control" placeholder="e.g., my-project" required />
        </div>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" class="form-control" placeholder="What is this team working on?"></textarea>
        </div>

        <div class="form-group">
            <label asp-for="LeaderName">Leader Agent Name</label>
            <input asp-for="LeaderName" class="form-control" placeholder="e.g., leader" required />
        </div>

        <div class="form-group">
            <label asp-for="AgentType">Agent Type</label>
            <select asp-for="AgentType" class="form-control">
                <option value="claude">Claude Code</option>
                <option value="codex">Codex</option>
                <option value="gemini">Gemini</option>
                <option value="kimi">Kimi</option>
                <option value="nanobot">Nanobot</option>
                <option value="custom">Custom</option>
            </select>
        </div>

        <div style="display:flex;gap:0.75rem;">
            <button type="submit" class="btn btn-primary">Create Team</button>
            <a href="/" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
