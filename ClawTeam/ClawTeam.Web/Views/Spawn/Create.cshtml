@model SpawnAgentForm
@{
    var teamName = (string)ViewBag.TeamName;
    ViewData["Title"] = $"Spawn Agent - {teamName}";
}

<div class="page-header">
    <h1>Spawn Agent &mdash; @teamName</h1>
</div>

<div class="card" style="max-width:600px;">
    <form asp-controller="Spawn" asp-action="Create" asp-route-id="@teamName" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="AgentName">Agent Name</label>
            <input asp-for="AgentName" class="form-control" placeholder="alice" required />
        </div>

        <div class="form-group">
            <label asp-for="AgentType">Agent Type</label>
            <select asp-for="AgentType" class="form-control">
                <option value="claude">Claude Code</option>
                <option value="codex">Codex</option>
                <option value="gemini">Gemini</option>
                <option value="kimi">Kimi</option>
                <option value="nanobot">Nanobot</option>
                <option value="custom">Custom</option>
            </select>
        </div>

        <div class="form-group">
            <label asp-for="Task">Task / Prompt</label>
            <textarea asp-for="Task" class="form-control" placeholder="Implement the authentication module..."></textarea>
        </div>

        <div class="form-group">
            <label asp-for="Command">Custom Command (optional)</label>
            <input asp-for="Command" class="form-control" placeholder="e.g., python my_agent.py" />
        </div>

        <div style="display:flex;gap:0.75rem;">
            <button type="submit" class="btn btn-success">Spawn Agent</button>
            <a href="/Team/Details/@teamName" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
