@model List<ClawTeam.Web.Spawn.RunningAgent>
@{
    var teamName = (string)ViewBag.TeamName;
    ViewData["Title"] = $"Running Agents - {teamName}";
}

<div class="page-header">
    <div>
        <h1>Running Agents &mdash; @teamName</h1>
        <span class="subtitle">@Model.Count agent(s) running</span>
    </div>
    <div style="display:flex;gap:0.5rem;">
        <a href="/Spawn/Create/@teamName" class="btn btn-success">+ Spawn Agent</a>
        <a href="/Team/Details/@teamName" class="btn btn-secondary">Back to Team</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2>No agents running</h2>
        <p>Spawn an agent to start work.</p>
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>ID</th>
                <th>Status</th>
                <th>PID</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var agent in Model)
            {
                <tr>
                    <td><strong>@agent.Name</strong></td>
                    <td><code>@agent.Id</code></td>
                    <td><span style="color:var(--green);font-weight:600;">@agent.Status</span></td>
                    <td>@(agent.ProcessId?.ToString() ?? "N/A")</td>
                </tr>
            }
        </tbody>
    </table>
}
