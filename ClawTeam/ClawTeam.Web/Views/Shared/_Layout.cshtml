<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClawTeam</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <a class="navbar-brand" href="/">
                <span class="brand-icon">&#x1F99E;</span> ClawTeam
            </a>
            <div class="nav-links">
                <a href="/" class="nav-link">Home</a>
                <a href="/Board" class="nav-link">Board</a>
                <a href="/Team" class="nav-link">Teams</a>
                <a href="/Team/Create" class="nav-link btn-create">+ New Team</a>
            </div>
        </div>
    </nav>

    <main class="container">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <p>ClawTeam &mdash; Agent Swarm Intelligence &mdash; ASP.NET MVC Port</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
