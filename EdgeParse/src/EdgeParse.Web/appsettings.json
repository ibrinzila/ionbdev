{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EdgeParse": {
    "ReadingOrder": "XyCut",
    "TableMethod": "Default",
    "IncludeHeaderFooter": false,
    "FilterConfig": {
      "FilterHiddenText": true,
      "FilterOutOfPage": true,
      "FilterTinyText": true,
      "FilterHiddenOcg": true,
      "ContrastRatioThreshold": 1.5,
      "MinFontSize": 3.0
    }
  }
}
